# ==============================================================================
# JIU-JITSU CLOUD WEB APP - VARIÁVEIS DE AMBIENTE (12-Factor App)
# ==============================================================================

# Porta e Interface de Escuta (Cloud Port Binding)
PORT=8000
HOST=0.0.0.0

# Ambiente de Execução (development, staging, production)
APP_ENV=production

# String de Conexão com o Banco de Dados
# Para desenvolvimento local / IaaS simples:
DATABASE_URL=sqlite:///./jiujitsu.db
# Para PostgreSQL em Nuvem (AWS RDS, Render Postgres, Railway):
# DATABASE_URL=postgresql://usuario:senha@host-do-banco.rds.amazonaws.com:5432/jiujitsu_db

# Credenciais Administrativas para Criação de Cursos e Gestão
ADMIN_USER=admin
ADMIN_PASSWORD=senha_jiujitsu_123

# Chave Secreta para Geração de Tokens de Acesso
SECRET_KEY=jiujitsu-cloud-secret-token-2026-super-segura

# CORS (origens permitidas, separadas por vírgula ou * para público)
CORS_ORIGINS=*
